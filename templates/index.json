        },
        "column2": {
          "type": "column",
          "settings": {
            "title": "Soft, premium yarns",
            "text": "<p>We choose skin-friendly cotton and wool blends that stay soft and beautiful, wash after wash.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column3": {
          "type": "column",
          "settings": {
