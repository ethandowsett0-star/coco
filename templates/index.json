    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "row1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does shipping take?",
            "icon": "truck",
            "row_content": "<p>Every piece is made to order, so please allow 3–7 business days of crafting time. Once shipped, delivery usually takes 5–14 business days depending on your location. You'll receive a tracking number as soon as your order is on its way.</p>"
          }
        },
        "row2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I request a custom color or size?",
            "icon": "heart",
            "row_content": "<p>Absolutely! Reach out through our contact page before ordering and tell us what you have in mind — we love custom projects.</p>"
          }
        },
        "row3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I care for my crochet items?",
            "icon": "washing",
            "row_content": "<p>Hand wash cold with a mild soap, gently press out the water and dry flat. Please avoid wringing and machine drying to keep the stitches beautiful.</p>"
          }
        },
        "row4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is your return policy?",
            "icon": "return",
            "row_content": "<p>We accept returns within 30 days of delivery for unused items in their original condition. Custom-made orders are final sale. See our refund policy for full details.</p>"
          }
        }
      },
